{
  "name": "easycrypt-companion",
  "displayName": "EasyCrypt Companion",
  "description": "Interactive proof development for EasyCrypt in VS Code, with Proof General keybindings for Emacs users.",
  "version": "0.1.2",
  "publisher": "mehdigolpayegani",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mehdigolpayegani/easycrypt-companion.git"
  },
  "bugs": {
    "url": "https://github.com/mehdigolpayegani/easycrypt-companion/issues"
  },
  "homepage": "https://github.com/mehdigolpayegani/easycrypt-companion#readme",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "easycrypt",
    "proof assistant",
    "cryptography",
    "proof general",
    "theorem prover"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [],
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test --test-concurrency=1 out/test/*.test.js",
    "grammar": "node scripts/gen-grammar.mjs",
    "test:e2e": "npm run compile && node out/test/e2e/run.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.2.0",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "easycrypt",
        "aliases": [
          "EasyCrypt",
          "easycrypt"
        ],
        "extensions": [
          ".ec",
          ".eca"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "easycrypt-output",
        "aliases": [
          "EasyCrypt Output"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "easycrypt",
        "scopeName": "source.easycrypt",
        "path": "./syntaxes/easycrypt.tmLanguage.json"
      },
      {
        "language": "easycrypt-output",
        "scopeName": "source.easycrypt.output",
        "path": "./syntaxes/easycrypt-output.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "easycryptCompanion.next",
        "title": "Next Command",
        "category": "EasyCrypt",
        "icon": "$(arrow-down)"
      },
      {
        "command": "easycryptCompanion.undo",
        "title": "Undo Last Command",
        "category": "EasyCrypt",
        "icon": "$(arrow-up)"
      },
      {
        "command": "easycryptCompanion.gotoCursor",
        "title": "Process to Cursor",
        "category": "EasyCrypt",
        "icon": "$(debug-step-into)"
      },
      {
        "command": "easycryptCompanion.processBuffer",
        "title": "Process to End of File",
        "category": "EasyCrypt",
        "icon": "$(run-all)"
      },
      {
        "command": "easycryptCompanion.retractBuffer",
        "title": "Retract Buffer (Reset)",
        "category": "EasyCrypt",
        "icon": "$(debug-restart)"
      },
      {
        "command": "easycryptCompanion.interrupt",
        "title": "Interrupt Prover",
        "category": "EasyCrypt",
        "icon": "$(debug-stop)"
      },
      {
        "command": "easycryptCompanion.exit",
        "title": "Exit Prover",
        "category": "EasyCrypt"
      },
      {
        "command": "easycryptCompanion.restart",
        "title": "Restart Prover",
        "category": "EasyCrypt"
      },
      {
        "command": "easycryptCompanion.layout",
        "title": "Reset Layout (Goals and Response Panes)",
        "category": "EasyCrypt"
      },
      {
        "command": "easycryptCompanion.showGoals",
        "title": "Show Goals",
        "category": "EasyCrypt"
      },
      {
        "command": "easycryptCompanion.togglePanes",
        "title": "Hide or Show the Panes",
        "category": "EasyCrypt",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "easycryptCompanion.gotoProcessedEnd",
        "title": "Go to End of Processed Region",
        "category": "EasyCrypt"
      },
      {
        "command": "easycryptCompanion.sendCommand",
        "title": "Send Command to Prover...",
        "category": "EasyCrypt"
      },
      {
        "command": "easycryptCompanion.print",
        "title": "Print...",
        "category": "EasyCrypt"
      },
      {
        "command": "easycryptCompanion.search",
        "title": "Search Lemmas...",
        "category": "EasyCrypt"
      },
      {
        "command": "easycryptCompanion.locate",
        "title": "Locate...",
        "category": "EasyCrypt"
      },
      {
        "command": "easycryptCompanion.toggleWeakCheck",
        "title": "Toggle Weak-Check Mode",
        "category": "EasyCrypt"
      },
      {
        "command": "easycryptCompanion.insertLastOutputAsComment",
        "title": "Insert Last Output as Comment",
        "category": "EasyCrypt"
      },
      {
        "command": "easycryptCompanion.clearResponse",
        "title": "Clear Response Pane",
        "category": "EasyCrypt"
      },
      {
        "command": "easycryptCompanion.statusMenu",
        "title": "Prover Menu",
        "category": "EasyCrypt"
      },
      {
        "command": "easycryptCompanion.showLog",
        "title": "Show Log",
        "category": "EasyCrypt"
      },
      {
        "command": "easycryptCompanion.allowEditing",
        "title": "Allow Editing This Library File",
        "category": "EasyCrypt"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "easycryptCompanion.retractBuffer",
          "when": "editorLangId == easycrypt",
          "group": "navigation@1"
        },
        {
          "command": "easycryptCompanion.undo",
          "when": "editorLangId == easycrypt",
          "group": "navigation@2"
        },
        {
          "command": "easycryptCompanion.next",
          "when": "editorLangId == easycrypt",
          "group": "navigation@3"
        },
        {
          "command": "easycryptCompanion.gotoCursor",
          "when": "editorLangId == easycrypt",
          "group": "navigation@4"
        },
        {
          "command": "easycryptCompanion.processBuffer",
          "when": "editorLangId == easycrypt",
          "group": "navigation@5"
        },
        {
          "command": "easycryptCompanion.interrupt",
          "when": "editorLangId == easycrypt && easycryptCompanion.busy",
          "group": "navigation@6"
        },
        {
          "command": "easycryptCompanion.togglePanes",
          "when": "editorLangId == easycrypt",
          "group": "navigation@7"
        }
      ],
      "commandPalette": [
        {
          "command": "easycryptCompanion.statusMenu",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "easycryptCompanion.next",
        "key": "alt+down",
        "when": "editorTextFocus && editorLangId == easycrypt && config.easycryptCompanion.keybindings.vscodeStyle"
      },
      {
        "command": "easycryptCompanion.undo",
        "key": "alt+up",
        "when": "editorTextFocus && editorLangId == easycrypt && config.easycryptCompanion.keybindings.vscodeStyle"
      },
      {
        "command": "easycryptCompanion.gotoCursor",
        "key": "alt+right",
        "when": "editorTextFocus && editorLangId == easycrypt && config.easycryptCompanion.keybindings.vscodeStyle"
      },
      {
        "command": "easycryptCompanion.processBuffer",
        "key": "alt+end",
        "when": "editorTextFocus && editorLangId == easycrypt && config.easycryptCompanion.keybindings.vscodeStyle"
      },
      {
        "command": "easycryptCompanion.retractBuffer",
        "key": "alt+home",
        "when": "editorTextFocus && editorLangId == easycrypt && config.easycryptCompanion.keybindings.vscodeStyle"
      },
      {
        "command": "easycryptCompanion.next",
        "key": "ctrl+c ctrl+n",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.undo",
        "key": "ctrl+c ctrl+u",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.gotoCursor",
        "key": "ctrl+c ctrl+enter",
        "when": "editorTextFocus && editorLangId == easycrypt && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.gotoCursor",
        "key": "ctrl+c ctrl+m",
        "when": "editorTextFocus && editorLangId == easycrypt && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.processBuffer",
        "key": "ctrl+c ctrl+b",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.retractBuffer",
        "key": "ctrl+c ctrl+r",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.interrupt",
        "key": "ctrl+c ctrl+c",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.exit",
        "key": "ctrl+c ctrl+x",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.layout",
        "key": "ctrl+c ctrl+l",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.layout",
        "key": "ctrl+c ctrl+o",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.togglePanes",
        "key": "ctrl+x 1",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.showGoals",
        "key": "ctrl+c ctrl+p",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.gotoProcessedEnd",
        "key": "ctrl+c ctrl+.",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.sendCommand",
        "key": "ctrl+c ctrl+v",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.print",
        "key": "ctrl+c ctrl+a ctrl+p",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.print",
        "key": "ctrl+c ctrl+a ctrl+c",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.locate",
        "key": "ctrl+c ctrl+a ctrl+l",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.search",
        "key": "ctrl+c ctrl+f",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.insertLastOutputAsComment",
        "key": "ctrl+c ctrl+;",
        "when": "editorTextFocus && editorLangId == easycrypt && !editorReadonly && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "easycryptCompanion.clearResponse",
        "key": "ctrl+c ctrl+w",
        "when": "editorTextFocus && (editorLangId == easycrypt || editorLangId == easycrypt-output) && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      },
      {
        "command": "editor.toggleFold",
        "key": "ctrl+c v",
        "when": "editorTextFocus && editorLangId == easycrypt && (config.easycryptCompanion.keybindings.proofGeneral == 'always' || (isMac && config.easycryptCompanion.keybindings.proofGeneral == 'auto'))"
      }
    ],
    "configuration": {
      "title": "EasyCrypt Companion",
      "properties": {
        "easycryptCompanion.executable": {
          "type": "string",
          "default": "easycrypt",
          "markdownDescription": "Path to the `easycrypt` binary. When left as `easycrypt`, the extension looks on `PATH` and then in `~/.opam/*/bin`."
        },
        "easycryptCompanion.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments passed after `easycrypt cli -emacs`, e.g. `[\"-I\", \"path/to/lib\", \"-timeout\", \"10\"]`."
        },
        "easycryptCompanion.keybindings.proofGeneral": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Enable Proof General keys (C-c C-n, C-c C-u, C-c C-RET, ...) on macOS only, where Ctrl+C is not Copy.",
            "Enable Proof General keys on every platform. On Linux and Windows this makes Ctrl+C a prefix key in EasyCrypt files, so it no longer copies.",
            "Disable Proof General keys."
          ],
          "default": "auto",
          "markdownDescription": "Proof General (Emacs) key bindings, e.g. `C-c C-n` to process the next command."
        },
        "easycryptCompanion.keybindings.vscodeStyle": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable Alt-based navigation keys: `Alt+Down` next, `Alt+Up` undo, `Alt+Right` to cursor, `Alt+End` to end of file, `Alt+Home` retract."
        },
        "easycryptCompanion.layout": {
          "type": "string",
          "enum": [
            "threePane",
            "beside",
            "manual"
          ],
          "enumDescriptions": [
            "Script on the left, goals top-right, response bottom-right (like Proof General).",
            "Open goals and response panes beside the script without changing the layout.",
            "Never open the panes automatically; use the Show Goals and Reset Layout commands."
          ],
          "default": "threePane",
          "description": "How the goals and response panes are arranged when proving starts."
        },
        "easycryptCompanion.followMode": {
          "type": "string",
          "enum": [
            "locked",
            "ignore"
          ],
          "enumDescriptions": [
            "The cursor moves to the end of the processed region after Next and Undo (Proof General default).",
            "The cursor never moves."
          ],
          "default": "locked",
          "description": "How the cursor moves when commands are processed."
        },
        "easycryptCompanion.library.readOnly": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Open files of EasyCrypt's library read-only, with a link at the top to allow editing. Library files inside the workspace are never locked."
        },
        "easycryptCompanion.completion": {
          "type": "boolean",
          "default": true,
          "description": "Suggest the names of lemmas, operators and other declarations while typing. When off, only VS Code's own word suggestions remain."
        },
        "easycryptCompanion.trace": {
          "type": "boolean",
          "default": false,
          "description": "Log every command sent to and every reply received from EasyCrypt in the \"EasyCrypt Companion\" output channel."
        }
      }
    },
    "configurationDefaults": {
      "[easycrypt-output]": {
        "editor.lineNumbers": "off",
        "editor.minimap.enabled": false,
        "editor.renderLineHighlight": "none"
      }
    },
    "colors": [
      {
        "id": "easycryptCompanion.processedBackground",
        "description": "Background of the processed (locked) region of an EasyCrypt script.",
        "defaults": {
          "light": "#eaf8ff",
          "dark": "#483d8b55",
          "highContrast": "#483d8b55",
          "highContrastLight": "#eaf8ff"
        }
      },
      {
        "id": "easycryptCompanion.queuedBackground",
        "description": "Background of commands waiting to be processed by EasyCrypt.",
        "defaults": {
          "light": "#ffe4e1",
          "dark": "#ba55d344",
          "highContrast": "#ba55d344",
          "highContrastLight": "#ffe4e1"
        }
      }
    ]
  }
}
