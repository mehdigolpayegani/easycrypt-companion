{
  "name": "easycrypt-companion",
  "displayName": "EasyCrypt Companion",
  "description": "Interactive proof development for EasyCrypt in VS Code, with Proof General keybindings for Emacs users.",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "easycrypt",
    "proof assistant",
    "cryptography",
    "proof general",
    "theorem prover"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test --test-concurrency=1 out/test/*.test.js",
    "grammar": "node scripts/gen-grammar.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "easycrypt",
        "aliases": [
          "EasyCrypt",
          "easycrypt"
        ],
        "extensions": [
          ".ec",
          ".eca"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "easycrypt",
        "scopeName": "source.easycrypt",
        "path": "./syntaxes/easycrypt.tmLanguage.json"
      }
    ]
  }
}
