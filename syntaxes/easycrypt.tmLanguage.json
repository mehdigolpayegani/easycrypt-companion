{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "EasyCrypt",
  "scopeName": "source.easycrypt",
  "comment": "Generated by scripts/gen-grammar.mjs from ecLexer.mll. Do not edit by hand.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#names"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "comment": "(*op*) and ( op ) are operators, not comments",
          "name": "keyword.operator.easycrypt",
          "match": "\\((?=\\*[=<>+\\-*/\\\\%&^|:#$]*\\))\\*?[=<>+\\-*/\\\\%&^|:#$]*\\)"
        },
        {
          "name": "comment.block.documentation.easycrypt",
          "begin": "\\(\\*[&^]",
          "end": "[&^]?\\*\\)",
          "patterns": [
            {
              "include": "#nestedComment"
            }
          ]
        },
        {
          "name": "comment.block.easycrypt",
          "begin": "\\(\\*",
          "end": "\\*\\)",
          "patterns": [
            {
              "include": "#nestedComment"
            }
          ]
        }
      ]
    },
    "nestedComment": {
      "begin": "\\(\\*",
      "end": "\\*\\)",
      "patterns": [
        {
          "include": "#nestedComment"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.easycrypt",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.easycrypt",
          "match": "\\\\."
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(lemma|axiom|hint|equiv|hoare|phoare|ehoare|realize)\\s+([A-Za-z_][A-Za-z0-9_']*)",
          "captures": {
            "1": {
              "name": "keyword.control.easycrypt"
            },
            "2": {
              "name": "entity.name.function.lemma.easycrypt"
            }
          }
        },
        {
          "match": "\\b(op|pred|abbrev|const|inductive|notation)\\s+(?:\\[[^\\]]*\\]\\s*)?([A-Za-z_][A-Za-z0-9_']*)",
          "captures": {
            "1": {
              "name": "keyword.control.easycrypt"
            },
            "2": {
              "name": "entity.name.function.easycrypt"
            }
          }
        },
        {
          "match": "\\b(module\\s+type|module|type|subtype)\\s+(?:\\([^)]*\\)\\s*)?([A-Za-z_][A-Za-z0-9_']*)",
          "captures": {
            "1": {
              "name": "keyword.control.easycrypt"
            },
            "2": {
              "name": "entity.name.type.easycrypt"
            }
          }
        },
        {
          "match": "\\b(theory|section)\\s+([A-Za-z_][A-Za-z0-9_']*)",
          "captures": {
            "1": {
              "name": "keyword.control.easycrypt"
            },
            "2": {
              "name": "entity.name.namespace.easycrypt"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "invalid.illegal.admit.easycrypt",
          "match": "\\b(?:admitted|admit)\\b"
        },
        {
          "name": "keyword.control.easycrypt",
          "match": "\\b(?:axiomatized|bitstring|exception|inductive|abstract|instance|notation|circuit|declare|include|realize|require|section|subtype|timeout|abbrev|export|global|import|locate|module|prover|remove|rename|search|theory|abort|array|axiom|clone|const|lemma|local|print|proof|bind|dump|exit|from|goal|hint|pred|Self|type|why3|with|end|qed|Top|as|of|op|Pr)\\b"
        },
        {
          "name": "keyword.other.closing-tactic.easycrypt",
          "match": "\\b(?:reflexivity|assumption|check|exact|solve|done|edit|coq|fix|smt|by)\\b"
        },
        {
          "name": "keyword.operator.tactical.easycrypt",
          "match": "\\b(?:expect|extens|first|last|try|do)\\b"
        },
        {
          "name": "support.function.tactic.easycrypt",
          "match": "\\b(?:transitivity|interleave|pr_bounded|splitwhile|byehoare|byphoare|idassign|progress|rwnormal|simplify|symmetry|algebra|byequiv|exfalso|fieldeq|fission|modpath|outline|replace|rewrite|trivial|weakmem|byupto|change|conseq|fusion|inline|rcondf|rcondt|ringeq|rndsem|unroll|alias|apply|cfold|clear|congr|delta|eager|ecall|exlim|field|idtac|logic|right|split|subst|auto|beta|bypr|call|case|elim|have|iota|kill|left|move|pose|ring|skip|suff|swap|wlog|zeta|cbv|eta|fel|gen|rnd|seq|sim|sp|wp)\\b"
        },
        {
          "name": "keyword.other.program.easycrypt",
          "match": "\\b(?:islossless|ehoare|exists|forall|phoare|return|async|equiv|hoare|match|raise|while|elif|else|glob|proc|then|for|fun|let|res|var|if|in|is)\\b"
        },
        {
          "name": "keyword.other.internal.easycrypt",
          "match": "\\b(?:pragma|debug|fail|time|undo)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.easycrypt",
          "match": "\\b(?:0x[0-9a-fA-F]+|[0-9]+(?:\\.[0-9]+)?)\\b"
        },
        {
          "name": "constant.language.easycrypt",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "names": {
      "patterns": [
        {
          "name": "variable.other.memory.easycrypt",
          "match": "&(?:[A-Za-z_][A-Za-z0-9_']*|[0-9]+)"
        },
        {
          "name": "storage.type.variable.easycrypt",
          "match": "'[A-Za-z_][A-Za-z0-9_']*"
        },
        {
          "name": "entity.name.namespace.easycrypt",
          "match": "\\b[A-Z][A-Za-z0-9_']*(?=\\.[A-Za-z_(])"
        }
      ]
    }
  }
}
